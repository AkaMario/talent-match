{
  "realm": "talentmatch",
  "enabled": true,
  "displayName": "TalentMatch",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "sslRequired": "none",
  "defaultRoles": ["student"],
  "defaultDefaultClientScopes": ["profile", "email", "roles", "web-origins"],
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Estudiante"
      },
      {
        "name": "company",
        "description": "Empresa"
      },
      {
        "name": "default-roles-talentmatch",
        "composite": true,
        "composites": {
          "realm": ["student"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-talentmatch"
  },
  "clients": [
    {
      "clientId": "talentmatch-web",
      "name": "TalentMatch Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "talentmatch-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "estudiante",
      "email": "estudiante@talentmatch.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Mariana",
      "lastName": "Torres",
      "credentials": [
        {
          "type": "password",
          "value": "Demo2026!",
          "temporary": false
        }
      ],
      "realmRoles": ["student"]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "empresa",
      "email": "empresa@talentmatch.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Nexo",
      "lastName": "Tech",
      "credentials": [
        {
          "type": "password",
          "value": "Demo2026!",
          "temporary": false
        }
      ],
      "realmRoles": ["company"]
    }
  ]
}
